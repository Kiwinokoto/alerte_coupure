POWERWATCH_DB=/data/powerwatch.db
POWERWATCH_INGEST_TOKEN=replace-with-a-long-random-token
POWERWATCH_OFFLINE_SECONDS=420
POWERWATCH_WATCHDOG_SECONDS=60

# Optional SMTP alerts.
POWERWATCH_SMTP_HOST=
POWERWATCH_SMTP_PORT=587
POWERWATCH_SMTP_USER=
POWERWATCH_SMTP_PASSWORD=
POWERWATCH_SMTP_FROM=
POWERWATCH_ALERT_TO=
POWERWATCH_SMTP_STARTTLS=1
